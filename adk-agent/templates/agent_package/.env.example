# ---- モデル（references/models.md）----
# 既定: gemini-3.5-flash（Gemini Developer API に無料枠あり）
# Claude を使う場合（有料・ANTHROPIC_API_KEY 必須）: AGENT_MODEL=anthropic/claude-sonnet-5
# Claude on Vertex AI（有料）: AGENT_MODEL=vertex-anthropic/claude-sonnet-5
AGENT_MODEL=gemini-3.5-flash

# ---- Gemini Developer API 経路（ローカル既定）----
GOOGLE_API_KEY=your-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ---- Vertex AI 経路（本番）。使う場合は上の 2 行をコメントアウトしてこちらを有効化 ----
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# ※ USE_VERTEXAI=TRUE とプレースホルダの PROJECT が同居すると API キー経路でも Vertex に接続して PERMISSION_DENIED になる

# ---- 環境 ----
AGENT_ENV=dev                 # dev / staging / prod
LOG_LEVEL=INFO
# DATABASE_URL=sqlite+aiosqlite:///sessions.db     # staging
# AGENT_ENGINE_ID=1234567890                        # prod
ENABLE_MEMORY_BANK=false      # true にすると dev は InMemory、それ以外は Vertex AI Memory Bank（有料）
# RAG_CORPUS_ID=projects/P/locations/R/ragCorpora/ID

# ---- Compaction / ガードレール閾値 ----
COMPACTION_INTERVAL=20
COMPACTION_OVERLAP=2
MAX_LLM_CALLS=10
MAX_TOOL_CALLS=50
MAX_TOOL_CALLS_PER_TOOL=10
COST_LIMIT_USD=1.0
APPROVAL_AMOUNT_THRESHOLD=500000
